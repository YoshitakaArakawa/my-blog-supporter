# Playwright session cache (X login cookies etc.)
.playwright-cli/
# Playwright MCP browser working dir (snapshots / screenshots)
.playwright-mcp/

# Private working area for articles (raw notes / intermediate artifacts).
# All article work happens here; publishing goes through /publish-article into published/.
output/

# Guards for the public layer: third-party raw materials (copyright) and
# Wix snapshots (account IDs / embeds) must never be committed, even after
# a directory migrates into published/
published/*/references/
published/**/*.mhtml

# Claude Code settings (local-only)
.claude/settings.json
.claude/settings.local.json

# Local MCP server wiring for ad-hoc investigation (points at a localhost port
# whose server lives under output/, so it is meaningless in a fresh clone)
.mcp.json

# Images & illustration sources (article screenshots / figure sources)
*.png
*.html
*.svg

# Exception: skill-owned templates (distributed assets, not article material)
!.claude/skills/**/templates/*.html

# OS metadata
Thumbs.db
.DS_Store

# Node dependencies (textlint etc.)
node_modules/
